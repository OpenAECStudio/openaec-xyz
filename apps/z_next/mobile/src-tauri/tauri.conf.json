{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z-Next",
  "mainBinaryName": "z-next",
  "version": "0.1.0",
  "identifier": "eu.openaec.znext",
  "build": {
    "frontendDist": "../www"
  },
  "app": {
    "windows": [
      {
        "title": "Z-Next",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Z-Next op de telefoon",
    "longDescription": "Z-Next voor uitvoerende bedrijven in de bouw: projecten, uren, planning en offertes op de telefoon.",
    "copyright": "OpenAEC Foundation",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
