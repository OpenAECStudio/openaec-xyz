{
  "name": "z-next-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Z-Next als app voor Android en iOS (Tauri 2 mobile)",
  "scripts": {
    "tauri": "tauri",
    "icon": "tauri icon src-tauri/icons/source.png",
    "android:init": "tauri android init --ci",
    "android:apk": "tauri android build --debug --apk --target aarch64 --target x86_64",
